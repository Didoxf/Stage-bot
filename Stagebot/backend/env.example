# =====================================================
# BACKEND — Variables d'environnement
# Coller dans Render > Environment
# =====================================================

PORT=3001
NODE_ENV=production

# MongoDB Atlas — depuis mongodb.com (gratuit)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pfe_ensem?retryWrites=true&w=majority

# JWT Secret — mets une longue chaîne aléatoire
JWT_SECRET=change_this_to_a_very_long_random_secret_string_2024

# Admin credentials
ADMIN_EMAIL=admin@ensem.fr
ADMIN_PASSWORD=TonMotDePasseAdmin123

# Groq API
GROQ_API_KEY=gsk_ton_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# CORS
ALLOWED_ORIGINS=https://ton-frontend.vercel.app

# Message si pas de réponse trouvée
NOT_FOUND_MSG=Je n'ai pas pu trouver une réponse à votre question. Merci de contacter le responsable de stage selon votre domaine : Sciences de l'Information SAMIAMAZA@hotmail.fr | Mécanique mattiasbordron@hotmail.fr | Génie Électrique jean-philippeMARTIN@hotmail.fr
